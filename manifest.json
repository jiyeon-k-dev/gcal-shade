{
  "manifest_version": 3,
  "name": "GCal Shade",
  "version": "0.1.0",
  "description": "구글 캘린더 주/일 보기의 특정 시간대에 배경색을 칠합니다.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "GCal Shade 설정"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
